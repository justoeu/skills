    passo_sonar_diferencial() {
      # POR QUE ESTE PASSO EXISTE (2026-10-19): o sonarqube.yml só roda no push para a main, então o
      # Quality Gate nunca aparece num PR. O scan diferencial era manual e cada agente escolhia o
      # escopo — "só produto", "N/A: diff só de testes", nenhum — e quatro issues em testes Java
      # (S5778, S8745, 2x S6126) deixaram o gate da main em ERROR por três merges. O script escaneia
      # TODO arquivo do branch que o projeto real analisa (testes e Java incluídos) e compara com os
      # issues já abertos na main. Sem token/scanner/servidor ele sai 3: PULADO, nunca verde.
      azul "Sonar diferencial (sonarqube.yml só roda na main: o gate da main medido antes do PR)"
      if ! precisa python3; then
        pulo "Sonar diferencial — python3 ausente"
        return 0
      fi
      if ! python3 -B -m unittest discover -s scripts/tests -p test_sonar_diferencial.py \
          > $LOGS/sonar-diferencial-unit.log 2>&1; then
        falha "testes do sonar-diferencial.py — ver $LOGS/sonar-diferencial-unit.log"
        return 0
      fi
      if python3 scripts/sonar-diferencial.py --listar 2>/dev/null | grep -qE '^ +(main|test) +.*\.java$'; then
        # O analisador Java lê bytecode: compila só o que mudou desde a suíte (ou tudo, se cacheada).
        if ! (cd backend && mvn -B -q "${MVN_WORKERS[@]}" -DskipTests test-compile > $LOGS/sonar-compile.log 2>&1); then
          falha "Sonar diferencial — test-compile do backend falhou, ver $LOGS/sonar-compile.log"
          return 0
        fi
      fi
      python3 scripts/sonar-diferencial.py > $LOGS/sonar-diferencial.log 2>&1
      case $? in
        0) ok "Sonar diferencial ($(grep -oE 'NOVOS: [0-9]+ · hotspots novos: [0-9]+|nada a medir' $LOGS/sonar-diferencial.log | tail -1))" ;;
        3) pulo "Sonar diferencial — não rodou: $(grep -oE 'NÃO RODOU: .*' $LOGS/sonar-diferencial.log | tail -1)" ;;
        *) falha "Sonar diferencial — issue novo no branch, ver $LOGS/sonar-diferencial.log" ;;
      esac
    }
    
    passo_frontend_coverage() {
      # POR QUE ESTE PASSO EXISTE (2026-10-19): o sonarqube.yml roda o Vitest com cobertura V8 em
      # quatro shards de UM worker; instrumentado e serial, o relógio de parede é outro, e um
      # snapshot que dependia de um timer de animação (ripple da MUI, 550 ms) passou em todo PR e
      # quebrou o shard 4/4 na main (run 39213770326). Mesmos argumentos do workflow, sem o blob.
      azul "Frontend - cobertura V8 (sonarqube.yml: Cobertura frontend x4, maxWorkers=1)"
      local shard falhou=0
      for shard in 1 2 3 4; do
        if ! (cd frontend && CI=true npm test -- --coverage --shard=$shard/4 --maxWorkers=1 \
            --coverage.processingConcurrency=1 --coverage.reporter=json \
            --coverage.reportsDirectory="$LOGS/fe-coverage-$shard" > $LOGS/fe-coverage-$shard.log 2>&1); then
          falha "cobertura frontend (shard $shard/4) — ver $LOGS/fe-coverage-$shard.log"
          falhou=1
        fi
      done
      [ "$falhou" -eq 0 ] && ok "cobertura frontend 4/4 shards (maxWorkers=1, como o sonarqube.yml)"
      return 0
    }
    
    passo_lock_drift() {
      # POR QUE ESTE PASSO EXISTE (2026-08-21): ate esta data nenhum gate do projeto
      # perguntava ao registro de advisories do npm. Medido: o `Trivy FS scan` da CI
      # NAO reportou GHSA-2v37-7h3g-55p8 e o `.trivyignore` esta vazio — entao nao foi
      # supressao. (Por que o Trivy nao a viu nao foi apurado; o fato e que ninguem
      # consultava o npm.)
      # O que passou por isso: o override de `nanoid` estava fixado em 3.3.17 enquanto
      # a advisory afeta `<3.3.18`. O override existia, estava ativo, e nao corrigia
      # nada — duas advisories HIGH (nanoid, e postcss que a herda) vivas com 16/16
      # verdes. Mesma classe do buraco do scan de imagem: o gate media menos do que
      # dizia. O job `npm-audit` do ci.yml passou a rodar o mesmo comando no PR.
      # DEP-PRI-106: `npm audit` resolve pelo package-lock.json, NAO pelo node_modules.
      # Medido em 2026-08-12: lock em brace-expansion 5.0.9, disco em 5.0.8
      # (GHSA-rgw5-rvv9-x895, HIGH) e o audit devolvia 0 vulnerabilidades — verde sobre a
      # arvore que roda aqui. `npm ls --all` nao serve: valida contra o RANGE do dependente
      # (5.0.8 satisfaz ^5.0.5) e neste repo ja sai 1 pelo peer do jsx-a11y. O passo abaixo
      # compara pacote a pacote a arvore instalada com o lock e FALHA no drift — antes do
      # audit, senao o audit mede uma arvore que nao e a instalada. Cura: `npm ci`.
      azul "Frontend - node_modules x package-lock.json (DEP-PRI-106)"
      if node scripts/npm-lock-drift.mjs frontend > $LOGS/lock-drift.log 2>&1; then
        ok "$(tail -1 $LOGS/lock-drift.log)"
      else
        falha "node_modules do frontend diverge do package-lock.json — rode \`cd frontend && npm ci\`; ver $LOGS/lock-drift.log"
      fi
    }
    
    passo_npm_audit() {
      azul "Frontend - npm audit (ci.yml: Security - npm audit)"
      # Mesma distincao do job da CI (2026-09-12): `npm audit` devolve exit 1 tanto
      # para "achou HIGH" quanto para "o registro respondeu Bad Request". Sem separar
      # os dois, um gate vermelho por motivo alheio vira um gate que se aprende a
      # pular — e aqui o custo e pior que na CI, porque o dev esta com o commit na mao.
      # Erro de registro retenta; achado reprova na hora, sem retry.
      local npm_audit_rc=1 tentativa
      for tentativa in 1 2 3; do
        (cd frontend && npm audit --audit-level=high > $LOGS/audit.log 2>&1)
        npm_audit_rc=$?
        [ "$npm_audit_rc" -eq 0 ] && break
        if grep -qE 'audit endpoint returned an error|Bad Request|ECONNRESET|ETIMEDOUT|socket hang up|503 Service Unavailable|429 Too Many Requests' $LOGS/audit.log; then
          printf "  \033[33mRETRY\033[0m npm audit: erro do registro npm (tentativa %s/3)\n" "$tentativa"
          sleep $((tentativa * 5))
          continue
        fi
        break
      done
      if [ "$npm_audit_rc" -eq 0 ]; then
        ok "npm audit (0 HIGH/CRITICAL)"
      elif grep -qE 'audit endpoint returned an error|Bad Request|ECONNRESET|ETIMEDOUT|socket hang up|503 Service Unavailable|429 Too Many Requests' $LOGS/audit.log; then
        falha "npm audit NAO RODOU — o registro npm falhou nas 3 tentativas. Isto nao e achado de vulnerabilidade; ver $LOGS/audit.log"
      else
        falha "npm audit — $(grep -oE '[0-9]+ (high|critical)' $LOGS/audit.log | tr '\n' ' ')ver $LOGS/audit.log"
      fi
    }
    
    passo_gitleaks() {
      # ------------------------------------------------------------- 3. Segredos
      azul "Gitleaks scan (ci.yml: Gitleaks scan)"
      if precisa gitleaks; then
        # Espelha o gitleaks-action: varre o que ESTE PR introduz, e nada além.
        #
        # NUNCA usar `--no-git` como fallback: ele ignora o .gitignore e varreu 4,92 GB
        # de scratch local (strix_runs/, logs de agente) reportando 142 "leaks" em
        # 13m39s — nenhum deles commitável. Gate que sempre grita é gate ignorado.
        # Os DOIS lados rodam sempre: commits já feitos na branch E o que ainda está no
        # working tree. Eram alternativos (`if commits; else working tree`), e bastava um
        # commit na branch para o gate parar de olhar staged/modificado/não-rastreado — que é
        # justamente o estado ao rodar isto antes do SEGUNDO commit exigido pelo §6.
        local gl_total=0 base arq alvos unicos gl_falhou gl_pulados
        base=$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null || echo "")
        if [ -n "$base" ] && [ "$base" != "$(git rev-parse HEAD)" ]; then
          # Já há commits na branch: varre exatamente eles, como a action faz.
          if gitleaks git --config .gitleaks.toml --no-banner --redact -v \
               --log-opts="$base..HEAD" . > $LOGS/gitleaks.log 2>&1; then
            ok "gitleaks (commits $base..HEAD)"
          else
            falha "gitleaks — SEGREDO nos commits desta branch, ver $LOGS/gitleaks.log"
          fi
        fi
        if true; then
          # E sempre: TUDO que entraria no PRÓXIMO commit — staged, modificado
          # rastreado E não-rastreado.
          #
          # As três fontes são UNIDAS, nunca alternativas. A versão anterior usava
          # "staged; se nada staged, os modificados", e um único `git mv` bastava para
          # tornar o ramo staged não-vazio e o fallback inalcançável: o gate varria 1
          # arquivo de um diff de 17 e reportava OK. Pior, arquivo NÃO-RASTREADO não
          # era varrido por nenhum dos dois ramos — ou seja, um arquivo NOVO contendo
          # segredo (o caso mais provável de todos) passava batido. É a mesma
          # patologia dos outros gates desta base: não distinguir "varreu e não achou"
          # de "não varreu".
          #
          # while-read em vez de mapfile: mapfile é bash 4+, e o bash de fábrica do
          # macOS é 3.2 — lá ele falharia em silêncio, deixando `alvos` vazio e o
          # gate passando sem ter varrido nada.
          # -z / read -d '': sem isso o git devolve caminho com byte não-ASCII em forma
          # C-quoted ("Docs/integra\303\247\303\243o.md", core.quotePath=true é o default),
          # o teste `[ -f "$arq" ]` falha sobre a string com aspas e o arquivo é PULADO EM
          # SILÊNCIO — enquanto o contador ainda o soma. Numa base toda em português, com
          # Docs/ nomeado por domínio, esse é o caminho mais provável de um arquivo NOVO
          # escapar do gate. Medido em repositório descartável.
          alvos=()
          while IFS= read -r -d '' arq; do [ -n "$arq" ] && alvos+=("$arq"); done \
            < <(git diff --cached -z --name-only --diff-filter=ACMR)
          while IFS= read -r -d '' arq; do [ -n "$arq" ] && alvos+=("$arq"); done \
            < <(git diff -z --name-only --diff-filter=ACMR)
          while IFS= read -r -d '' arq; do [ -n "$arq" ] && alvos+=("$arq"); done \
            < <(git ls-files --others --exclude-standard -z)
          # dedup preservando ordem (o mesmo arquivo pode estar staged e modificado)
          if [ ${#alvos[@]} -gt 0 ]; then
            unicos=()
            while IFS= read -r arq; do [ -n "$arq" ] && unicos+=("$arq"); done \
              < <(printf '%s\n' "${alvos[@]}" | awk '!vistos[$0]++')
            alvos=("${unicos[@]}")
          fi
          if [ ${#alvos[@]} -eq 0 ]; then
            [ -z "$base" ] || [ "$base" = "$(git rev-parse HEAD)" ] \
              && ok "gitleaks (nada a varrer: sem commits novos e sem alterações)"
          else
            : > $LOGS/gitleaks.log
            gl_falhou=0
            gl_pulados=0
            for arq in "${alvos[@]}"; do
              # Alvo listado pelo git e ausente do disco é DEFEITO DO GATE, não motivo para
              # silenciar: era assim que o arquivo com nome não-ASCII sumia sem deixar rastro.
              if [ ! -f "$arq" ]; then
                gl_pulados=$((gl_pulados + 1))
                echo "gitleaks: alvo listado mas ausente: $arq" >> $LOGS/gitleaks.log
                continue
              fi
              if ! gitleaks dir --config .gitleaks.toml --no-banner --redact -v "$arq" \
                     >> $LOGS/gitleaks.log 2>&1; then
                gl_falhou=1
              fi
            done
            gl_total=${#alvos[@]}
            if [ "$gl_pulados" -gt 0 ]; then
              falha "gitleaks — ${gl_pulados} alvo(s) NÃO varrido(s), ver $LOGS/gitleaks.log"
            elif [ "$gl_falhou" -eq 0 ]; then
              ok "gitleaks (${gl_total} arquivo(s) na árvore de trabalho)"
            else
              falha "gitleaks — SEGREDO em arquivo a commitar, ver $LOGS/gitleaks.log"
            fi
          fi
        fi
      else
        pulo "gitleaks não instalado (brew install gitleaks)"
      fi
    }
    
    passo_semgrep() {
      # ----------------------------------------------------------------- 4. SAST
      azul "Security - Semgrep SAST (ci.yml)"
      if precisa semgrep; then
        local base sg_tmp
        base=$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null || echo "")
        if [ -n "$base" ]; then
          # O --baseline-commit faz reset/checkout da base NO DIRETÓRIO em que roda e depois volta. Em
          # 2026-10-12, rodado na árvore de trabalho, uma falha no meio (arquivo somente leitura) deixou a
          # branch na base e a pasta misturada. Por isso ele roda numa CÓPIA descartável: worktree destacado
          # do HEAD + o estado não commitado (alterados/novos copiados, apagados removidos).
          sg_tmp="$(mktemp -d "$(prefixo_worktree_semgrep).XXXXXX")"
          rmdir "$sg_tmp"
          if git worktree add --detach "$sg_tmp" HEAD >/dev/null 2>&1; then
            git ls-files -z -m -o --exclude-standard | rsync -a --from0 --files-from=- ./ "$sg_tmp"/ 2>/dev/null
            git ls-files -z -d | (cd "$sg_tmp" && xargs -0 rm -f -- 2>/dev/null) || true
            if (cd "$sg_tmp" && semgrep scan \
                 --config p/default \
                 --config p/owasp-top-ten \
                 --config p/secrets \
                 --config p/java \
                 --config p/typescript \
                 --config p/react \
                 --config p/dockerfile \
                 --baseline-commit "$base" \
                 --severity ERROR \
                 --error \
                 --metrics off \
                 --exclude graphify-out \
                 --exclude Docs/audit/ultra-deep \
                 --exclude '*.test.ts' \
                 --exclude '*.test.tsx' \
                 --exclude '*.test.js') > $LOGS/semgrep.log 2>&1; then
              ok "semgrep (diff-aware vs ${base:0:8}, em cópia descartável)"
            else
              falha "semgrep — ver $LOGS/semgrep.log"
            fi
            git worktree remove --force "$sg_tmp" >/dev/null 2>&1 || rm -rf "$sg_tmp"
          else
            falha "semgrep — não foi possível criar a cópia descartável (git worktree add)"
          fi
        elif semgrep --config=auto --error -q . > $LOGS/semgrep.log 2>&1; then
          ok "semgrep"
        else
          falha "semgrep — ver $LOGS/semgrep.log"
        fi
      else
        pulo "semgrep não instalado (pipx install semgrep) — a CI AINDA vai rodá-lo"
      fi
    }
    
    passo_trivy_fs() {
      # ------------------------------------------------------------- 5. Trivy FS
      azul "Security - Trivy FS scan (ci.yml)"
      if precisa trivy; then
        # --scanners vuln: o job "Security - Trivy FS scan" da CI é o gate de
        # DEPENDÊNCIAS (é o que o comentário dele diz). Ligar secret/misconfig aqui
        # reencontra as chaves AWS históricas em Docs/ (SEC-ORC-003, já conhecidas) e
        # o gate passa a falhar sempre — gate que sempre grita é gate ignorado.
        # Segredo é coberto pelo gitleaks acima, no escopo certo.
        # Worktrees de agentes (.claude/worktrees, .worktrees) são gitignored e não existem no checkout
        # da CI: varrê-los multiplica o scan por N cópias do repo e estoura o timeout do trivy.
        # --timeout 15m: a análise do pom.xml resolve POMs-pai pela rede (Maven Central); medido em
        # 2026-10-08, ~570-590 s nesta máquina, acima do default de 5 min. Não muda o que é reportado.
        if trivy fs --timeout 15m --scanners vuln --severity HIGH,CRITICAL \
             --skip-dirs .claude/worktrees --skip-dirs .worktrees \
             --ignore-unfixed --ignorefile .trivyignore --exit-code 1 . \
             > $LOGS/trivyfs.log 2>&1; then
          ok "trivy fs"
        else
          falha "trivy fs — ver $LOGS/trivyfs.log"
        fi
      else
        pulo "trivy não instalado (brew install trivy)"
      fi
    }
    
    passo_compose() {
      # ------------------------------------------------------ 5b. Compose - Validate
      # 2026-09-01: o PR #539 entrou com 12.659 testes verdes e o job "Compose - Validate"
      # quebrou em `services.backend.environment.[15]: unexpected type map` — um item de
      # `environment:` com `: ` sem aspas vira MAPA para o YAML. O SnakeYAML do
      # DockerComposeValidityTest aceitava; só o `docker compose config` rejeita. Este
      # passo roda o mesmo comando da CI, com um .env efêmero equivalente ao dela, e
      # NUNCA toca o .env real da raiz (usa --env-file num temporário). Variável
      # exportada no shell VENCE o --env-file no compose, então cada chamada roda num
      # subshell com as chaves do .env efêmero desfeitas — senão um
      # `export AWS_KMS_ARNS_PERMITIDOS=...` no shell do dev mascara o `:?` do arquivo.
      # Deliberadamente NÃO espelha o 3º passo do job ("Infra realmente sobe": `up -d`
      # de rabbitmq + postgres até ficarem healthy) — sobe containers e leva minutos; a CI
      # continua a executá-lo.
      azul "Compose - Validate (ci.yml)"
      if precisa docker && precisa openssl && docker compose version >/dev/null 2>&1; then
        local compose_env compose_pg_secrets s v f
        compose_env="$(mktemp /tmp/ci-local-compose-env.XXXXXX)"
        # SDD-20 W7 #3: arquivos de senha efêmeros do PostgreSQL de deploy (Docker secrets), como na CI.
        compose_pg_secrets="$(mktemp -d /tmp/ci-local-pg-secrets.XXXXXX)"
        registrar_temporario "$compose_env" "$compose_pg_secrets"
        gen() { openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48; }
        for s in postgres_superuser_password appgp_owner_password appgp_app_password; do
          gen > "$compose_pg_secrets/$s"
        done
        {
          for v in POSTGRES_PASSWORD POSTGRES_OWNER_PASSWORD POSTGRES_APP_PASSWORD \
                   RABBITMQ_ADMIN_PASSWORD \
                   RABBITMQ_PASSWORD MINIO_ROOT_PASSWORD REDIS_PASSWORD JWT_SECRET \
                   PII_ENCRYPTION_SEED PII_BLIND_INDEX_SEED AUTH_GRACE_CACHE_ENCRYPTION_SEED \
                   CERTIFICATE_ENCRYPTION_SEED DOCUMENTO_ACESSO_ENCRYPTION_SEED \
                   GATEWAY_ENCRYPTION_SEED RECEITA_ENCRYPTION_SEED \
                   RECEITA_INTEGRACAO_ENCRYPTION_SEED; do
            echo "$v=$(gen)"
          done
          echo "OTP_HMAC_SECRET=$(openssl rand -hex 32)"
          echo "MINIO_ROOT_USER=civalidate$(openssl rand -hex 4)"
          echo "POSTGRES_SECRETS_DIR=$compose_pg_secrets"
          echo "TRUSTED_PROXY_CIDRS=none"
          echo "APP_FRONTEND_BASE_URL=https://ci.example.invalid"
          echo "CORS_ALLOWED_ORIGINS=https://ci.example.invalid"
          echo "DOCUMENTO_PUBLIC_BASE_URL=https://ci.example.invalid/documentos/publico/"
          echo "AWS_S3_BACKUP_DESTINOS_PERMITIDOS=sa-east-1/ci-example-invalid-backup"
          echo "AWS_KMS_ARNS_PERMITIDOS=arn:aws:kms:sa-east-1:111122223333:"
          echo "STORAGE_PRIMARY_SSE_MODE=SSE_S3"
          echo "POSTGRES_RUNTIME_IMAGE=registry.invalid/app-gp-postgres-runtime@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          echo "REDIS_RUNTIME_IMAGE=registry.invalid/app-gp-redis-runtime@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          echo "FLYWAY_RUNTIME_IMAGE=registry.invalid/app-gp-flyway-runtime@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
          echo "CONFIG_SERVER_HOST=config-server.invalid"
          echo "CONFIG_SERVER_PASSWORD=$(gen)"
          echo "VITE_API_URL=https://api.ci.example.invalid/api"
          echo "VITE_ENV_LABEL=CI"
          echo "VITE_JOBRUNR_DASHBOARD_URL=https://jobs.ci.example.invalid"
          echo "API_ORIGIN=https://api.ci.example.invalid"
          echo "WS_ORIGIN=wss://api.ci.example.invalid"
        } > "$compose_env"
        : > $LOGS/compose.log
        compose_hermetico() {
          ( while IFS='=' read -r k _; do unset "$k"; done < "$compose_env"
            docker compose --env-file "$compose_env" "$@" config -q )
        }
        for f in docker-compose.yml docker-compose.services.yml docker-compose.app.yml; do
          if compose_hermetico -f "$f" >> $LOGS/compose.log 2>&1; then
            ok "docker compose config: $f"
          else
            falha "docker compose config: $f — ver $LOGS/compose.log"
          fi
        done
        if compose_hermetico -f docker-compose.yml -f docker-compose.dast.yml \
             >> $LOGS/compose.log 2>&1; then
          ok "docker compose config: docker-compose.yml + docker-compose.dast.yml"
        else
          falha "docker compose config: overlay DAST — ver $LOGS/compose.log"
        fi
        rm -f "$compose_env"
        # Ambiente local HTTPS (deployments/local): o teste gera segredos/CA num diretório efêmero
        # e valida os quatro arranjos do compose + o contrato do local.sh. Mesmo passo do ci.yml.
        # CI=1: sem docker/jq/curl os casos que dependem deles FALHAM em vez de serem pulados em silêncio.
        if CI=1 python3 -B -m unittest discover -s deployments/local/tests >> $LOGS/compose.log 2>&1; then
          ok "ambiente local: deployments/local/tests"
        else
          falha "ambiente local: deployments/local/tests — ver $LOGS/compose.log"
        fi
      else
        pulo "docker compose ou openssl ausente — a CI AINDA vai validar os compose"
      fi
    }
    
    passo_imagens() {
    # --------------------------------------------- 6. IMAGENS — o passo que faltava
      azul "release.yml — Trivy IMAGE scan (o passo que NENHUM PR executa)"
      if ! precisa trivy || ! precisa docker; then
        pulo "trivy e/ou docker ausentes — este é o passo que quebrou a main em 2026-08-14"
      else
        # O release publica índice linux/amd64 + linux/arm64 e escaneia AS DUAS variantes
        # (SDD-08 §Delta 2026-10-06): CVE só da variante arm64 também quebra o release.
        # O estágio de build usa --platform=$BUILDPLATFORM, então a plataforma não nativa só
        # emula o estágio final (segundos). Sem emulação para ela, PULADO explícito; a
        # plataforma NATIVA nunca é pulada (sem buildx, o build falha e aparece como FALHA).
        local plataformas_builder plataforma_nativa alvo plataforma arch tag CACHEBUST_LOCAL
        plataformas_builder="$(docker buildx inspect 2>/dev/null | grep -E '^ *Platforms:' || true)"
        case "$(docker version --format '{{.Server.Arch}}' 2>/dev/null)" in
          arm64|aarch64) plataforma_nativa=linux/arm64 ;;
          *) plataforma_nativa=linux/amd64 ;;
        esac
        CACHEBUST_LOCAL="$(date +%s)"
        for alvo in backend frontend; do
          for plataforma in linux/amd64 linux/arm64; do
            arch="${plataforma#linux/}"
            if [ "$plataforma" != "$plataforma_nativa" ] && ! grep -q "$plataforma" <<<"$plataformas_builder"; then
              pulo "docker build $alvo $plataforma — builder buildx sem $plataforma (instale binfmt/QEMU); a CI AINDA vai escanear"
              continue
            fi
            tag="appgp-${alvo}:ci-local-${arch}"
            printf '  construindo %s...\n' "$tag"
            # CACHEBUST espelha o release.yml (github.run_id): sem ele a camada do
            # `apk upgrade` fica cacheada e o scan local passa/falha com CVEs de
            # semanas atrás em vez do estado real do build da CI.
            if docker buildx build --platform "$plataforma" --load --build-arg "CACHEBUST=$CACHEBUST_LOCAL" \
                 -t "$tag" "$RAIZ/$alvo" > "$LOGS/build-$alvo-$arch.log" 2>&1; then
              # Mesmas flags do release.yml: severity HIGH,CRITICAL + ignore-unfixed + .trivyignore
              if trivy image --severity HIGH,CRITICAL --ignore-unfixed \
                   --ignorefile .trivyignore --exit-code 1 "$tag" \
                   > "$LOGS/trivyimg-$alvo-$arch.log" 2>&1; then
                ok "trivy image $alvo $plataforma"
              else
                falha "trivy image $alvo $plataforma — CVE na imagem, ver $LOGS/trivyimg-$alvo-$arch.log"
                grep -E "CVE-|Total:" "$LOGS/trivyimg-$alvo-$arch.log" | head -10 | sed 's/^/      /'
              fi
            else
              falha "docker build $alvo $plataforma — ver $LOGS/build-$alvo-$arch.log"
            fi
          done
        done
      fi
    }
    
    passo_runtime_images() {
      # OPS-RUNTIME-LIBEXPAT (SDD-08 §Delta 2026-10-18): espelho do job "Security - Runtime Images Supply
      # Chain" do ci.yml. Em 2026-10-17 o feed do Trivy passou a marcar libexpat no flyway-runtime e TODO PR
      # quebrou sem que este gate pudesse avisar, porque ele não rodava o script. Depende de feed externo:
      # nunca cacheável. Paridade ci.yml x ci-local travada em ci-local-acelerar.test.mjs.
      azul "ci.yml — Security - Runtime Images Supply Chain (runtimes de deploy, amd64 + arm64)"
      if ! precisa trivy || ! precisa docker; then
        pulo "runtime-images — trivy e/ou docker ausentes; a CI AINDA vai escanear os runtimes de deploy"
        return
      fi
      local plataformas_builder plataforma_nativa plataforma plataformas=""
      plataformas_builder="$(docker buildx inspect 2>/dev/null | grep -E '^ *Platforms:' || true)"
      case "$(docker version --format '{{.Server.Arch}}' 2>/dev/null)" in
        arm64|aarch64) plataforma_nativa=linux/arm64 ;;
        *) plataforma_nativa=linux/amd64 ;;
      esac
      for plataforma in linux/amd64 linux/arm64; do
        if [ "$plataforma" != "$plataforma_nativa" ] && ! grep -q "$plataforma" <<<"$plataformas_builder"; then
          pulo "runtime-images $plataforma — builder buildx sem $plataforma (instale binfmt/QEMU); a CI AINDA vai escanear"
          continue
        fi
        plataformas="${plataformas:+$plataformas,}$plataforma"
      done
      # Nunca em modo publicação nem com compose/.trivyignore/binários trocados pelo ambiente de quem roda.
      if env -u RUNTIME_IMAGE_PUBLISH_REGISTRY -u RUNTIME_IMAGE_PUBLISH_TAG -u RUNTIME_IMAGE_ENV_FILE \
           -u RUNTIME_IMAGE_COMPOSE_FILES -u TRIVY_IGNORE_FILE -u TRIVY_BIN -u DOCKER_BIN \
           RUNTIME_IMAGE_PLATFORMS="$plataformas" bash "$RAIZ/scripts/runtime-images-supply-chain-gate.sh" \
           > "$LOGS/runtime-images.log" 2>&1; then
        ok "runtime-images — gate de supply chain dos runtimes ($plataformas)"
      else
        falha "runtime-images — CVE ou pin inválido nos runtimes de deploy, ver $LOGS/runtime-images.log"
        grep -E "CVE-|Total:|must|missing|required" "$LOGS/runtime-images.log" | head -10 | sed 's/^/      /'
      fi
    }
    
    passo_pitest() {
      # ------------------------------------------------------------- 7. Pitest
      azul "Pitest (gate LOCAL do CLAUDE.md §6 — não roda na CI)"
      rodar_pitest "pitest" $LOGS/pit.log
    }
    
    passo_pitest_perfis() {
      # -------------------------------------------- 7b. Perfis extras de mutação
      # POR QUE ESTE PASSO EXISTE (2026-08-27): os perfis `*-mutation` do
      # pom.xml cobrem exatamente o que o gate default NÃO cobre — pipeline de
      # e-mail/outbox, assinatura PAdES + OTP, cleanup de comprovante e o NÚCLEO DE
      # AUTENTICAÇÃO (JwtUtil, RefreshTokenService, TokenFamilyRevocationService,
      # UserAdminAuthorizationService), além do perfil focado de agenda criado depois.
      # Até esta data NENHUM gate os executava: o
      # `ci-local.sh` roda o Pitest sem `-P` (só o perfil default) e o Pitest não roda
      # na CI por decisão registrada. A única coisa que os invocava era um comentário
      # no pom e uma linha no AGENTS.md dizendo "rode ao tocar X" — convenção humana,
      # não gate. Consequência: no primeiro refactor dessas classes a pressão de
      # mutação sobre emissão de JWT e rotação de refresh token sumiria sem sinal
      # nenhum, e os perfis continuariam verdes por nunca terem rodado.
      #
      # Por que CONDICIONAL ao diff em vez de sempre: medido em 2026-08-27 (máquina
      # sob carga, então são teto e não piso) — default 112s, outbox-mutation 64s,
      # assinatura-otp-mutation 84s, comprovante-cleanup-mutation 15s,
      # auth-mutation 13s. Esses quatro já custam ~176s em cima dos 112s do default;
      # `agenda-mutation`, criado depois, acrescenta outro conjunto focado. Rodar todos
      # sempre seria quase sempre medir código que o PR não tocou. Condicionar ao diff
      # mantém o custo em ZERO na maioria das execuções e dispara o perfil exatamente
      # quando o comentário do pom manda — só que sem depender de alguém lembrar.
      #
        azul "Pitest — perfis extras (condicionais ao diff do branch)"
        # <id do perfil>:<alternativas de nome de classe-alvo>
        perfis_mutacao=(
          "agenda-mutation:Agendamento|AgendaConfiguracaoService|AgendaEffectiveGradeResolver|AgendaGradeChangePolicyService|AgendaSlotLockService|AgendaConflictChecker|AgendaHorarioResolver|UserOpeningPeriodAvailability|ClinicaHorarioChangeGuardService|RecorrenciaPreviewService|UserConsultationDurationService|UserAgendaSettingsService|UserOpeningPeriodService|UserScheduleRestrictionsService|GatewayKeySelectionService|GatewayOutboundOutboxDispatcher"
          "aikido-policy-mutation:FinanceAccessContextService|FinanceiroAlertRecipientPolicy|FinanceiroOwnershipPolicy|PacienteFinanceiroAlertaInadimplencia|AnamnesePacienteService|UserContextService|ParcelaResponseMapper"
          "outbox-mutation:EmailOutbox|EmailDeliveryDedup|EmailMessageProducer|EmailMessageConsumer"
          "assinatura-otp-mutation:DocumentoAssinatura|PadesSignatureService|PfxValidationService|Pkcs12KeyMaterial|TwoFactorCode|EmailVerificationCode|OtpCodeSupport|EmailOtpCode"
          "comprovante-cleanup-mutation:PacienteFinanceiroComprovante"
          "auth-mutation:JwtUtil|RefreshTokenService|RefreshTokenRotationCoordinator|TokenFamilyRevocationService|UserAdminAuthorizationService"
          # SDD-01 §Delta 2026-10-18 / SDD-08 §Delta 2026-10-19c: caches de autorização e guardas dos pins.
          "auth-cache-mutation:JwtAuthenticationFilter|PermissionCacheService|CacheInvalidationService|VinculoClinicaAtivoConsulta|GaugeDeNegocioEmCache|PinsDeSegurancaGuard|PostgresDatasourceGuard"
          # SDD-20 §11.6: o adapter de advisory lock do PostgreSQL.
          "advisory-lock-mutation:PostgresAdvisoryLockAdapter"
          # SDD-19: derivacao/** é glob no pom — o último ramo casa qualquer arquivo do pacote (e o teste dele).
          "catalogo-sync-mutation:CatalogoSyncDiffService|CatalogoSyncAprovacaoService|ReautenticacaoService|ReautenticacaoRateLimiter|HostPermitidoNormalizador|UrlFonteValidator|PadraoLinkValidator|CatalogoSyncConfigService|catalogosync/derivacao/[A-Za-z0-9]+"
          "metrics-mutation:ManagementSecurity|ManagementContextRequestMatcher|MetricsScrape|RedisWindowRateLimiter"
          # SDD-21 §13: política de aviso, ponto único de entrega, escopo/preferências/contagens e o serviço da Central.
          "notificacoes-mutation:PoliticaDeAvisoNotificacao|NivelPrioridadeNotificacao|NotificacaoEntregaService|EscopoDaCentral|PreferenciasNotificacaoService|ContagensNotificacoesService|SystemNotificationService"
        )
        local alterados entrada perfil padrao
        alterados=$(arquivos_do_branch)
        for entrada in "${perfis_mutacao[@]}"; do
          perfil="${entrada%%:*}"
          padrao="${entrada#*:}"
          # Casa o BASENAME: `.../security/JwtUtil.java` e `.../security/JwtUtilTest.java`
          # disparam o mesmo perfil — o teste é parte da medição tanto quanto a classe.
          # O sufixo livre faz o gate errar para o lado SEGURO (dispara a mais), nunca
          # para o lado de não medir.
          if printf '%s\n' "$alterados" | grep -qE "/(${padrao})[A-Za-z0-9]*\.java$"; then
            rodar_pitest "pitest -P$perfil" "$LOGS/pit-$perfil.log" "-P$perfil"
          else
            printf '  \033[90m--\033[0m    %s (diff não toca as classes-alvo)\n' "$perfil"
          fi
        done
    }
    
    passo_pitest_pg_migrator() {
        azul "Pitest — pg-migrator (condicional ao diff do branch)"
        # SDD-20 §11.6: Pitest do copiador (tools/pg-migrator, módulo autônomo com pitest-maven no próprio pom).
        # As ITs dele sobem MySQL + PostgreSQL por Testcontainers: sem Docker o passo é PULADO, nunca omitido.
        PG_MIGRATOR_PIT_GATILHO='^tools/pg-migrator/(pom\.xml|src/(main|test)/java/.+\.java)$'
        local alterados
        alterados=$(arquivos_do_branch)
        if printf '%s\n' "$alterados" | grep -qE "$PG_MIGRATOR_PIT_GATILHO"; then
          if docker info >/dev/null 2>&1; then
            if [ -n "$TC_ESCOPO" ]; then
              adquirir_trava_tc || return
              local -x TESTCONTAINERS_REUSE_ENABLE=true APPGP_CI_LOCAL_TC_ESCOPO="$TC_ESCOPO"
            fi
            PIT_MODULO=tools/pg-migrator rodar_pitest "pitest pg-migrator" $LOGS/pit-pg-migrator.log
          else
            pulo "pitest pg-migrator — Docker indisponível (as ITs do copiador exigem Testcontainers)"
          fi
        else
          printf '  \033[90m--\033[0m    %s (diff não toca tools/pg-migrator)\n' "pitest pg-migrator"
        fi
    }
    
    
    # --fail-fast: depois dos gates baratos, qualquer FALHA encerra antes da suíte longa (devolve 1).
    seguir_apos_gates_baratos() {
      [ "$FAIL_FAST" -eq 1 ] && [ ${#FALHAS[@]} -gt 0 ] || return 0
      printf '\n\033[31m--fail-fast: %d falha(s) nos gates baratos; a suíte longa não foi executada.\033[0m\n' "${#FALHAS[@]}"
      return 1
    }
    
    # ================================================================== Execução
    # `source scripts/ci-local.sh` (testes de contrato) só define as funções: nenhum passo roda.
    if [ "${BASH_SOURCE[0]}" != "$0" ]; then
      return 0
    fi
    
    # Auto-teste do verificador acima. Sem ele, o ÚNICO jeito de exercitar o ramo de
    # FALHA seria carregar a máquina até o Pitest produzir RUN_ERROR de verdade — ou
    # seja, o ramo que existe justamente para pegar o falso verde nunca seria
    # exercitado, e o gate novo teria o mesmo defeito que veio consertar.
    #   printf "<mutations><mutation detected='true' status='RUN_ERROR' numberOfTestsRun='0'><killingTest /></mutation></mutations>" > /tmp/m.xml
    #   scripts/ci-local.sh --verificar-xml-pitest /tmp/m.xml 1 1   # deve sair 1
    if [ "$MODO" = "--verificar-xml-pitest" ]; then
      if [ $# -lt 2 ]; then
        printf 'uso: ci-local.sh --verificar-xml-pitest <mutations.xml> [gerados] [mortos]\n' >&2
        exit 2
      fi
      xml_alvo="$2"
      [ -f "$xml_alvo" ] || [ "${xml_alvo#/}" != "$xml_alvo" ] || xml_alvo="$CWD_CHAMADOR/$xml_alvo"
      checar_pitest_xml "$xml_alvo" "${3:-}" "${4:-}"
      exit $?
    fi
    
    ARGUMENTOS=("$@")
    [ "$MODO" = "full" ] || ARGUMENTOS=("${ARGUMENTOS[@]:1}")
    analisar_argumentos "${ARGUMENTOS[@]}" || exit 2
    configurar_workers || exit 2
    if [ "$LISTAR_PASSOS" -eq 1 ]; then
      listar_passos
      exit 0
    fi
    iniciar_cache || exit 2
    definir_escopo_tc
    trap ao_sair EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    
    if ! preflight; then
      resumir
      exit 1
    fi
    
    # Fase 1 — gates baratos (minutos). Segredo, SAST, compose e instrumentos aparecem ANTES da suíte
    # longa: em 2026-10 uma falha de gitleaks/semgrep só surgia depois de mais de 1 h de mvn test.
    passo recursos passo_recursos
    passo instrumentos passo_instrumentos
    passo cli-symlink passo_cli_symlink
    passo shards passo_shards
    passo lock-drift passo_lock_drift
    executar_paralelo gitleaks:passo_gitleaks semgrep:passo_semgrep trivy-fs:passo_trivy_fs npm-audit:passo_npm_audit
    passo compose passo_compose
    if ! seguir_apos_gates_baratos; then
      resumir
      exit 1
    fi
    
    # Fase 2 — suítes (Maven sequencial: nunca dois mvn pesados ao mesmo tempo).
    passo backend-test passo_backend_test
    passo fklock passo_fklock
    passo mysql-it passo_mysql_it
    passo docker-it passo_docker_it
    passo ci-it passo_ci_it
    passo sql-real-it rodar_sql_real_its
    passo pg-migrator passo_pg_migrator
    passo frontend-test passo_frontend_test
    passo frontend-build passo_frontend_build
    passo sonar-diferencial passo_sonar_diferencial
    
    # Fase 3 — fora do --fast: cobertura frontend, imagens e mutação.
    passo frontend-coverage passo_frontend_coverage
    passo imagens passo_imagens
    passo runtime-images passo_runtime_images
    passo pitest passo_pitest
    passo pitest-perfis passo_pitest_perfis
    passo pitest-pg-migrator passo_pitest_pg_migrator
    
    # ------------------------------------------------------------------ Resumo
