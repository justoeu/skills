    #!/usr/bin/env bash
    #
    # ci-local.sh — roda LOCALMENTE tudo que a CI roda, antes de commitar.
    #
    # POR QUE ESTE SCRIPT EXISTE (2026-08-14): o gate local do CLAUDE.md cobria
    # `mvn test` + `npm test` + `npm run build` + Pitest. A CI de PR (ci.yml) roda
    # MAIS que isso, e o workflow de release (release.yml, no push pra main) roda
    # um passo que nenhum PR executa: **Trivy sobre a IMAGEM Docker construída**.
    #
    # Resultado: dois PRs entraram com 16/16 verdes e o Release quebrou nos dois —
    # duas CVEs HIGH em `httpcore5` 5.4.2, dependência TRANSITIVA do AWS SDK que só
    # aparece no jar empacotado. O `Trivy FS scan` do PR não a enxerga. A `main`
    # ficou sem imagem publicada por um dia inteiro sem que nenhum PR ficasse
    # vermelho.
    #
    # Uso:
    #   scripts/ci-local.sh            # tudo
    #   scripts/ci-local.sh --fast     # pula Pitest, imagens Docker e a cobertura V8 do frontend
    #   scripts/ci-local.sh --images   # SÓ build de imagem + Trivy image scan (app + runtimes de deploy)
    #   scripts/ci-local.sh --sql-real-it
    #                                  # SÓ as migrações Flyway manifestadas em PostgreSQL real
    #
    #   scripts/ci-local.sh --verificar-xml-pitest <mutations.xml> [gerados] [mortos]
    #                                  # auto-teste do verificador do §7 (ver
    #                                  # checar_pitest_xml); não roda build nenhum.
    #
    # Opções, depois do modo (SDD-08 §Delta 2026-10-13, OPS-CI-LOCAL-RAPIDO):
    #   --listar-passos       imprime os ids dos passos, na ordem de execução, e sai
    #   --only <id[,id...]>   roda só esses passos (ex.: depois de corrigir um achado)
    #   --from <id>           roda do passo <id> em diante, na ordem do gate
    #   --no-cache            ignora o cache de passos: refaz tudo
    #   --fail-fast           para depois dos gates baratos se algum deles falhou
    #   --keep-containers     mantém, no fim, os containers reutilizáveis do pg-migrator
    #
    # Ambiente: CI_LOCAL_DISCO_MIN_GIB (25) · CI_LOCAL_CACHE_TTL_HORAS (24) ·
    #   CI_LOCAL_TEST_WORKERS (1..4; vazio = default 2 do pom; 4 só com memória para 4 heaps) ·
    #   CI_LOCAL_PERMITIR_SEM_DOCKER=1 (Docker fora vira PULADO em vez de abortar no preflight) ·
    #   CI_LOCAL_TC_REUSE=0 (sem reuso de containers do pg-migrator).
    #
    # Seleção, cache ou --fast verdes NÃO substituem o gate completo: o resumo diz "MODO FOCADO VERDE"
    # quando --only/--from estiver ativo. Passo reaproveitado do cache aparece como
    # "OK (cache: inalterado desde ...)" e só existe para entradas idênticas às de uma execução verde.
    #
    # Ferramentas necessárias: docker, trivy, gitleaks, mvn, npm, perl, shasum.
    # (semgrep é opcional — se ausente, o passo é PULADO e reportado como tal,
    #  nunca silenciosamente omitido.)
    
    set -uo pipefail
    
    # Falha ALTO se o bash for velho demais, em vez de deixar construções bash 4+
    # degradarem em silêncio e o gate passar sem ter verificado nada.
    # 4.4, não 4.0: antes dela "${array[@]}" vazio sob set -u é "unbound variable" (MVN_WORKERS vazio em todo mvn).
    if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] || { [ "${BASH_VERSINFO[0]:-0}" -eq 4 ] && [ "${BASH_VERSINFO[1]:-0}" -lt 4 ]; }; then
      printf 'ci-local.sh exige bash >= 4.4 (achou %s). No macOS: brew install bash\n' \
        "${BASH_VERSION:-desconhecido}" >&2
      exit 2
    fi
    
    # Guardado ANTES do cd: o modo --verificar-xml-pitest recebe um caminho digitado
    # pelo usuário, que ele espera relativo ao diretório DELE, não à raiz do repo.
    # BASH_SOURCE (com $0 de reserva para `bash -c`) também vale quando o script é carregado por `source`
    # nos testes de contrato.
    CWD_CHAMADOR="$PWD"
    SCRIPT_ABS="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/$(basename "${BASH_SOURCE[0]:-$0}")"
    cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." || exit 2
    RAIZ="$PWD"
    
    # Logs dos passos: no diretório git DESTE worktree, não em /tmp (revisão de segurança 2026-10-13 — caminho
    # fixo em /tmp segue symlink plantado por outro usuário da máquina, e dois worktrees sobrescreviam o log um
    # do outro). Caminho só com caracteres seguros, para poder aparecer sem aspas; senão, diretório do mktemp.
    LOGS="$(git rev-parse --absolute-git-dir 2>/dev/null)/ci-local-logs"
    if ! [[ "$LOGS" =~ ^/[A-Za-z0-9._/-]+$ ]] || ! mkdir -p "$LOGS" 2>/dev/null; then
